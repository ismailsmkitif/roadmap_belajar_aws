# Template Konfigurasi Database 3-Tier (.env)
# CATATAN KEAMANAN: Jangan commit file .env yang berisi kredensial asli ke repo!
# Salin file ini menjadi .env langsung di dalam EC2 server saat Hari 5.

PORT=80

# Masukkan RDS MySQL Endpoint Anda (didapat dari RDS Console > Databases > Connectivity & security)
# Contoh: my-three-tier-db.c9xxx.us-east-1.rds.amazonaws.com
DB_HOST=isi_dengan_rds_endpoint_anda

# Port default MySQL
DB_PORT=3306

# Username master database yang ditentukan saat membuat RDS di Hari 4
DB_USER=admin

# Password database yang ditentukan saat membuat RDS di Hari 4
DB_PASSWORD=isi_password_rahasia_anda

# Nama skema database
DB_NAME=webappdb
